# Database & Redis (Render Managed or Local)
DATABASE_URL=postgresql://user:password@localhost:5432/aegispay
REDIS_URL=redis://localhost:6379

# PayPal Developer Sandbox Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Channel3 Sponsored API
CHANNEL3_API_KEY=your_channel3_api_key_here

# Mastra Commerce AI Model & Provider (Deploy-time configurable)
COMMERCE_AGENT_MODEL=google/gemini-2.5-flash
# Alternative supported models:
# COMMERCE_AGENT_MODEL=google/gemini-1.5-pro
# COMMERCE_AGENT_MODEL=anthropic/claude-3-5-sonnet
# COMMERCE_AGENT_MODEL=openai/gpt-4o

# AI Provider API Keys
GEMINI_API_KEY=your_free_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
